#include <iostream> 

using namespace std;

int main() {

int hours;
bool isValid = false;

while (!isValid){

    cout << "Введите который час. ";
    cin >> hours;

    if(hours <0 ){

        cout << "Количество часов не может быть отрицательным. Введите коректное значение! \n";
    }else {
        isValid = true;
    }
}

for (int i = 0;i<hours;i++){
    cout<<"Ку-ку!\n";
}
} 

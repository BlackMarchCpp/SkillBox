#include <iostream>

int main() {
    int n, x;
    
    do {
        std::cout << "Введите количество бактерий: ";
        std::cin >> n;
    } while (n <= 0);

    do {
        std::cout << "Введите количество антибиотика: ";
        std::cin >> x;
    } while (x <= 0);

    int hour = 1;
    int current_antibiotic_power = 10; 

    while (n > 0 && x > 0) {
        
        n *= 2;

        n -= current_antibiotic_power;

        if (n < 0) {
            n = 0;
        }

        std::cout << "После " << hour << " часа бактерий осталось " << n << ". \n";

        x--;

        current_antibiotic_power--;
        if (current_antibiotic_power < 0) {
            current_antibiotic_power = 0;
        }

        hour++;
    }
}

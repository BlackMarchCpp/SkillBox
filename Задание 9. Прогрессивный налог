#include <iostream>

using namespace std;

int main () { 

    int income;

    cout << "Введите ваш доход: \n";
    cin >> income;

        int tax =0;

    if (income<=10000){

        tax= income * 0.13;
    } else if (income <=50000){

        tax= (10000*0.13) + ((income - 10000)*0.20);

    } else {

        tax = (10000*0.13) + (40000*0.20)+((income-50000)*0.30);
    }

        cout << "Сумма налога: " <<tax<< "\n";
}

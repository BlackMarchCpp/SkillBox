#include <iostream>

int main() {

    int dailyGrowth;
    int nightFade;
    int beginHeight;
    int dayBamboo;

    std::cout << "======================================================\n";
    std::cout <<"Добро пожаловатьв программу для контроля роста бамбука \n"; 
    std::cout << "======================================================\n";

    
    std::cout << "---------------Введите параметры роста-------------\n";
    std::cout << "Введите изначальный рост саженца: \n";
    std::cin >> beginHeight;
    std::cout << "Введите ежедневный рост: \n";
    std::cin >> dailyGrowth;
    std::cout << "Введите сьедаемый обьем ночью: \n";
    std::cin >> nightFade;
    std::cout << "Ввведите возраст бамбука в днях: " <<dayBamboo<< "дней. \n"; 
    std::cin >>dayBamboo;

    int totalGrowth;
    totalGrowth = beginHeight + (dailyGrowth - nightFade) * dayBamboo + dailyGrowth / 2;
    std::cout << "Высота бамбука к половине " <<dayBamboo<< " дня ровна " <<totalGrowth;    
}   

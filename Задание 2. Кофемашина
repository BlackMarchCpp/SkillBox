#include <iostream>

using namespace std;

int main() {
    
    int water, milk;
    cout << "Введите количество воды в мл: ";
    cin >> water;
    cout << "Введите количество молока в мл: ";
    cin >> milk;

    int americanoCount = 0;
    int latteCount = 0;

    while (true) {
       
        bool canMakeAmericano = (water >= 300);
        bool canMakeLatte = (water >= 30 && milk >= 270);

        if (!canMakeAmericano && !canMakeLatte) {
            break; 
        }

        int choice;
        cout << "Выберите напиток (1 — американо, 2 — латте): ";
        cin >> choice;

        if (choice != 1 && choice != 2) {
            cout << "Ошибка! Введите 1 или 2.\n";
            continue; 
        }

        if (choice == 1) {
            if (water >= 300) {
                water -= 300;
                americanoCount++;
                cout << "Ваш напиток готов.\n";
            } else {
                cout << "Не хватает воды\n";
            }
        } 
        else if (choice == 2) {
            if (water >= 30 && milk >= 270) {
                water -= 30;
                milk -= 270;
                latteCount++;
                cout << "Ваш напиток готов.\n";
            } else {
                
                if (water < 30 && milk < 270) {
                    cout << "Не хватает воды и молока\n";
                } else if (water < 30) {
                    cout << "Не хватает воды\n";
                } else {
                    cout << "Не хватает молока\n";
                }
            }
        }
    }

    
    cout << "***Отчёт***\n";
    cout << "Ингредиентов осталось:\n";
    cout << "      Вода: " << water << " мл\n";
    cout << "      Молоко: " << milk << " мл\n";
    cout << "Кружек американо приготовлено: " << americanoCount <<". \n";
    cout << "Кружек латте приготовлено: " << latteCount << ".\n";


}

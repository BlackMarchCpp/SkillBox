#include <iostream>
#include <vector>

using namespace std;

int main() {
    int n;
    cout << "Введите сумму для снятия: ";
    cin >> n;

    
    if (n <= 0) {
        cout << "Ошибка: сумма должна быть больше нуля.\n";
        
    }

    
    if (n > 150000) {
        cout << "Ошибка: Банкомат не может выдать за один раз более 150 000 рублей. \n";
        
    }

    
    if (n % 100 != 0) {
        cout << "Ошибка: Невозможно выдать ровно " << n << " рублей. Банкомат выдает суммы, кратные 100. \n";
        
    }

    
    int denominations[] = {5000, 2000, 1000, 500, 200, 100};
    int num_denoms = 6;

    cout << n << " рублей нужно выдать как: ";
    bool isFirst = true;

    
    for (int i = 0; i < num_denoms; ++i) {
       
        int count = n / denominations[i];
        
        
        if (count > 0) {
            if (!isFirst) {
                cout << ", ";
            }
            cout << count << " по " << denominations[i];
            isFirst = false;
            
            
            n = n % denominations[i];
        }
    }
    
    cout << ".\n";

    
}

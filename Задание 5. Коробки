#include <iostream>
#include <algorithm> 

using namespace std;

int main() {
    int A, B, C; 
    int M, N, K; 

    
    cout << "Введите размеры первой коробки (A B C): ";
    cin >> A >> B >> C;
    
    cout << "Введите размеры второй коробки (M N K): ";
    cin >> M >> N >> K;

    int box1[3] = {A, B, C};
    int box2[3] = {M, N, K};

    
    sort(box1, box1 + 3);
    sort(box2, box2 + 3);
    
    if (box1[0] <= box2[0] && box1[1] <= box2[1] && box1[2] <= box2[2]) {
        cout << "Да, первая коробка помещается во вторую. \n";
    } else {
        cout << "Нет, первая коробка не помещается во вторую. \n";
    }
    
}

#include <iostream>

using namespace std;

int main() {
    int day;
    
    
    cout << "Введите номер дня в мае: ";
    cin >> day;
    
    if (day < 1 || day > 31) {
        cout << "Введите корректный день \n";
    } 
    else if ((day >= 1 && day <= 5) || 
        (day >= 8 && day <= 10) || 
        (day % 7 == 6) || 
        (day % 7 == 0)) {
        
        cout << "Выходной \n";
    } else {
        cout << "Рабочий \n";
    } 
}
